      "path": "components/ui/whatsapp/styles/whatsapp.css",
      "content": "/*\n * WhatsApp UI Design Tokens\n * Extracted from web.whatsapp.com WDS (WhatsApp Design System)\n */\n\n@theme inline {\n  /* === Primary Brand Colors === */\n  --color-wa-green-50: var(--wa-green-50);\n  --color-wa-green-75: var(--wa-green-75);\n  --color-wa-green-100: var(--wa-green-100);\n  --color-wa-green-200: var(--wa-green-200);\n  --color-wa-green-300: var(--wa-green-300);\n  --color-wa-green-400: var(--wa-green-400);\n  --color-wa-green-450: var(--wa-green-450);\n  --color-wa-green-500: var(--wa-green-500);\n  --color-wa-green-600: var(--wa-green-600);\n  --color-wa-green-700: var(--wa-green-700);\n  --color-wa-green-750: var(--wa-green-750);\n  --color-wa-green-800: var(--wa-green-800);\n\n  /* === Emerald (Teal) === */\n  --color-wa-emerald-400: var(--wa-emerald-400);\n  --color-wa-emerald-500: var(--wa-emerald-500);\n  --color-wa-emerald-600: var(--wa-emerald-600);\n\n  /* === Neutral Gray === */\n  --color-wa-gray-50: var(--wa-gray-50);\n  --color-wa-gray-75: var(--wa-gray-75);\n  --color-wa-gray-100: var(--wa-gray-100);\n  --color-wa-gray-200: var(--wa-gray-200);\n  --color-wa-gray-300: var(--wa-gray-300);\n  --color-wa-gray-400: var(--wa-gray-400);\n  --color-wa-gray-500: var(--wa-gray-500);\n  --color-wa-gray-600: var(--wa-gray-600);\n  --color-wa-gray-700: var(--wa-gray-700);\n  --color-wa-gray-800: var(--wa-gray-800);\n  --color-wa-gray-850: var(--wa-gray-850);\n  --color-wa-gray-900: var(--wa-gray-900);\n  --color-wa-gray-1000: var(--wa-gray-1000);\n\n  /* === Sky Blue (Read Receipts) === */\n  --color-wa-sky-blue-300: var(--wa-sky-blue-300);\n  --color-wa-sky-blue-400: var(--wa-sky-blue-400);\n\n  /* === Red (Destructive/Negative) === */\n  --color-wa-red-300: var(--wa-red-300);\n  --color-wa-red-400: var(--wa-red-400);\n\n  /* === Cobalt === */\n  --color-wa-cobalt-300: var(--wa-cobalt-300);\n  --color-wa-cobalt-400: var(--wa-cobalt-400);\n\n  /* === Persistent/Brand === */\n  --color-wa-verified: var(--wa-verified);\n  --color-wa-always-white: var(--wa-always-white);\n  --color-wa-always-black: var(--wa-always-black);\n\n  /* === Profile Photo Avatars === */\n  --color-wa-avatar-brown: var(--wa-avatar-brown);\n  --color-wa-avatar-cobalt: var(--wa-avatar-cobalt);\n  --color-wa-avatar-green: var(--wa-avatar-green);\n  --color-wa-avatar-orange: var(--wa-avatar-orange);\n  --color-wa-avatar-pink: var(--wa-avatar-pink);\n  --color-wa-avatar-purple: var(--wa-avatar-purple);\n  --color-wa-avatar-red: var(--wa-avatar-red);\n  --color-wa-avatar-sky-blue: var(--wa-avatar-sky-blue);\n  --color-wa-avatar-teal: var(--wa-avatar-teal);\n  --color-wa-avatar-yellow: var(--wa-avatar-yellow);\n\n  /* === Semantic Colors (theme-aware) === */\n  --color-wa-bg: var(--wa-bg);\n  --color-wa-bg-deeper: var(--wa-bg-deeper);\n  --color-wa-bg-wash: var(--wa-bg-wash);\n  --color-wa-panel-bg: var(--wa-panel-bg);\n  --color-wa-panel-header-bg: var(--wa-panel-header-bg);\n  --color-wa-conversation-bg: var(--wa-conversation-bg);\n  --color-wa-compose-bg: var(--wa-compose-bg);\n\n  --color-wa-text-primary: var(--wa-text-primary);\n  --color-wa-text-secondary: var(--wa-text-secondary);\n  --color-wa-text-deemphasized: var(--wa-text-deemphasized);\n\n  --color-wa-bubble-outgoing: var(--wa-bubble-outgoing);\n  --color-wa-bubble-incoming: var(--wa-bubble-incoming);\n  --color-wa-bubble-system: var(--wa-bubble-system);\n  --color-wa-bubble-meta: var(--wa-bubble-meta);\n\n  --color-wa-border: var(--wa-border);\n  --color-wa-divider: var(--wa-divider);\n\n  --color-wa-primary: var(--wa-primary);\n  --color-wa-primary-hover: var(--wa-primary-hover);\n  --color-wa-icon-default: var(--wa-icon-default);\n  --color-wa-icon-lighter: var(--wa-icon-lighter);\n  --color-wa-hover: var(--wa-hover);\n  --color-wa-active: var(--wa-active);\n\n  --color-wa-read: var(--wa-read);\n  --color-wa-delivered: var(--wa-delivered);\n\n  --color-wa-unread-marker: var(--wa-unread-marker);\n  --color-wa-typing-dot: var(--wa-typing-dot);\n  --color-wa-input-bg: var(--wa-input-bg);\n  --color-wa-input-border: var(--wa-input-border);\n\n  --color-wa-wallpaper-bg: var(--wa-wallpaper-bg);\n  --color-wa-wallpaper-fg: var(--wa-wallpaper-fg);\n\n  /* === Additional Color Scales === */\n  --color-wa-teal-300: var(--wa-teal-300);\n  --color-wa-teal-400: var(--wa-teal-400);\n  --color-wa-teal-500: var(--wa-teal-500);\n\n  --color-wa-purple-300: var(--wa-purple-300);\n  --color-wa-purple-400: var(--wa-purple-400);\n\n  --color-wa-orange-300: var(--wa-orange-300);\n  --color-wa-orange-400: var(--wa-orange-400);\n\n  --color-wa-yellow-300: var(--wa-yellow-300);\n  --color-wa-yellow-400: var(--wa-yellow-400);\n\n  --color-wa-pink-300: var(--wa-pink-300);\n  --color-wa-pink-400: var(--wa-pink-400);\n\n  /* === Attachment Type Colors === */\n  --color-wa-attachment-document: var(--wa-attachment-document);\n  --color-wa-attachment-audio: var(--wa-attachment-audio);\n  --color-wa-attachment-photo: var(--wa-attachment-photo);\n  --color-wa-attachment-contact: var(--wa-attachment-contact);\n  --color-wa-attachment-camera: var(--wa-attachment-camera);\n  --color-wa-attachment-sticker: var(--wa-attachment-sticker);\n  --color-wa-attachment-poll: var(--wa-attachment-poll);\n  --color-wa-attachment-catalog: var(--wa-attachment-catalog);\n\n  /* === Semantic Text === */\n  --color-wa-text-disabled: var(--wa-text-disabled);\n  --color-wa-text-critical: var(--wa-text-critical);\n  --color-wa-text-success: var(--wa-text-success);\n  --color-wa-text-action: var(--wa-text-action);\n  --color-wa-system-msg: var(--wa-system-msg);\n  --color-wa-primary-title: var(--wa-primary-title);\n\n  /* === Typography === */\n  --font-wa: \"Segoe UI\", \"Helvetica Neue\", Helvetica, \"Lucida Grande\", Arial,\n    Ubuntu, Cantarell, \"Fira Sans\", sans-serif;\n\n  /* === Layout Constants === */\n  --spacing-wa-sidebar-width: var(--wa-sidebar-width);\n  --spacing-wa-sidebar-min-width: var(--wa-sidebar-min-width);\n  --spacing-wa-header-height: var(--wa-header-height);\n  --spacing-wa-compose-height: var(--wa-compose-height);\n  --spacing-wa-chat-spacing: var(--wa-chat-spacing);\n  --spacing-wa-avatar-sm: var(--wa-avatar-size-sm);\n  --spacing-wa-avatar-md: var(--wa-avatar-size-md);\n  --spacing-wa-avatar-lg: var(--wa-avatar-size-lg);\n\n  /* === Border Radius === */\n  --radius-wa-bubble: var(--wa-bubble-radius);\n\n  /* === Animation === */\n  --animate-wa-typing-bounce: wa-typing-bounce 1.2s ease-in-out infinite;\n}\n\n@keyframes wa-typing-bounce {\n  0%,\n  60%,\n  100% {\n    transform: translateY(0);\n  }\n  30% {\n    transform: translateY(-4px);\n  }\n}\n\n:root {\n  /* === Primary Brand Colors === */\n  --wa-green-50: #f2fdf0;\n  --wa-green-75: #e7fce3;\n  --wa-green-100: #d9fdd3;\n  --wa-green-200: #acfcac;\n  --wa-green-300: #71eb85;\n  --wa-green-400: #25d366;\n  --wa-green-450: #21c063;\n  --wa-green-500: #1daa61;\n  --wa-green-600: #1b8755;\n  --wa-green-700: #15603e;\n  --wa-green-750: #144d37;\n  --wa-green-800: #103529;\n\n  /* === Emerald (Teal) === */\n  --wa-emerald-400: #06cf9c;\n  --wa-emerald-500: #00a884;\n  --wa-emerald-600: #008069;\n\n  /* === Neutral Gray === */\n  --wa-gray-50: #fafafa;\n  --wa-gray-75: #f4f4f4;\n  --wa-gray-100: #eeeeee;\n  --wa-gray-200: #d8d8d8;\n  --wa-gray-300: #bdbdbd;\n  --wa-gray-400: #959393;\n  --wa-gray-500: #757778;\n  --wa-gray-600: #606263;\n  --wa-gray-700: #424445;\n  --wa-gray-800: #242626;\n  --wa-gray-850: #1d1f1f;\n  --wa-gray-900: #161717;\n  --wa-gray-1000: #0a0a0a;\n\n  /* === Sky Blue (Read Receipts) === */\n  --wa-sky-blue-300: #53bdeb;\n  --wa-sky-blue-400: #009de2;\n\n  /* === Red (Destructive/Negative) === */\n  --wa-red-300: #fb5061;\n  --wa-red-400: #f53947;\n\n  /* === Cobalt === */\n  --wa-cobalt-300: #53a6fd;\n  --wa-cobalt-400: #007bfc;\n\n  /* === Persistent/Brand === */\n  --wa-verified: #0085f4;\n  --wa-always-white: #ffffff;\n  --wa-always-black: #000000;\n\n  /* === Profile Photo Avatars === */\n  --wa-avatar-brown: #dba685;\n  --wa-avatar-cobalt: #53a6fd;\n  --wa-avatar-green: #25d366;\n  --wa-avatar-orange: #fc9775;\n  --wa-avatar-pink: #ff72a1;\n  --wa-avatar-purple: #a791ff;\n  --wa-avatar-red: #fb5061;\n  --wa-avatar-sky-blue: #53bdeb;\n  --wa-avatar-teal: #42c7b8;\n  --wa-avatar-yellow: #ffd279;\n}\n\n/* === Light Mode (WhatsApp Default) === */\n:root,\n[data-theme=\"light\"] {\n  /* Surfaces */\n  --wa-bg: #ffffff;\n  --wa-bg-deeper: #f0f2f5;\n  --wa-bg-wash: #f7f8fa;\n  --wa-panel-bg: #ffffff;\n  --wa-panel-header-bg: #ffffff;\n  --wa-conversation-bg: #f5f0e8;\n  --wa-compose-bg: #f0f2f5;\n\n  /* Content */\n  --wa-text-primary: #111b21;\n  --wa-text-secondary: #667781;\n  --wa-text-deemphasized: rgba(17, 27, 33, 0.4);\n\n  /* Chat Bubbles */\n  --wa-bubble-outgoing: #e7ffdb;\n  --wa-bubble-incoming: #ffffff;\n  --wa-bubble-system: #ffecd2;\n  --wa-bubble-radius: 7.5px;\n  --wa-bubble-meta: rgba(17, 27, 33, 0.45);\n\n  /* Lines */\n  --wa-border: #e9edef;\n  --wa-divider: rgba(134, 150, 160, 0.15);\n\n  /* Interactive */\n  --wa-primary: #008069;\n  --wa-primary-hover: #017561;\n  --wa-icon-default: #54656f;\n  --wa-icon-lighter: #8696a0;\n  --wa-hover: rgba(17, 27, 33, 0.05);\n  --wa-active: rgba(17, 27, 33, 0.1);\n\n  /* Read Receipts */\n  --wa-read: #53bdeb;\n  --wa-delivered: #8696a0;\n\n  /* Misc */\n  --wa-unread-marker: #25d366;\n  --wa-typing-dot: #8696a0;\n  --wa-input-bg: #ffffff;\n  --wa-input-border: #e4e6eb;\n\n  /* Chat Wallpaper */\n  --wa-wallpaper-bg: #f5f0e8;\n  --wa-wallpaper-fg: rgba(17, 27, 33, 0.05);\n  --wa-wallpaper-image: url(\"/wa-wallpaper.png\");\n  --wa-wallpaper-tint: rgba(229, 221, 213, 0.85);\n\n  /* Template header placeholder */\n  --wa-placeholder-bg: #ccd0d5;\n  --wa-placeholder-icon: brightness(0) saturate(100%) invert(42%) sepia(9%) saturate(621%) hue-rotate(155deg) brightness(94%) contrast(87%);\n\n  /* Template button icon — converts PNG to wa-emerald-500 (#00a884) */\n  --wa-btn-icon-filter: brightness(0) saturate(100%) invert(50%) sepia(97%) saturate(372%) hue-rotate(128deg) brightness(97%);\n\n  /* === Additional Color Scales === */\n  --wa-teal-300: #42c7b8;\n  --wa-teal-400: #02a698;\n  --wa-teal-500: #028377;\n\n  --wa-purple-300: #a791ff;\n  --wa-purple-400: #7f66ff;\n\n  --wa-orange-300: #fc9775;\n  --wa-orange-400: #fa6533;\n\n  --wa-yellow-300: #ffd279;\n  --wa-yellow-400: #ffb938;\n\n  --wa-pink-300: #ff72a1;\n  --wa-pink-400: #ff2e74;\n\n  /* === Attachment Type Colors === */\n  --wa-attachment-document: #7f66ff;\n  --wa-attachment-audio: #fa6533;\n  --wa-attachment-photo: #007bfc;\n  --wa-attachment-contact: #009de2;\n  --wa-attachment-camera: #ff2e74;\n  --wa-attachment-sticker: #02a698;\n  --wa-attachment-poll: #ffbc38;\n  --wa-attachment-catalog: #3a5564;\n\n  /* === Semantic Text === */\n  --wa-text-disabled: #d1d7db;\n  --wa-text-critical: #ea0038;\n  --wa-text-success: #1fa855;\n  --wa-text-action: #008069;\n  --wa-system-msg: #54656f;\n  --wa-primary-title: #41525d;\n\n  /* === Shadows === */\n  --wa-shadow-light: rgba(11, 20, 26, .08);\n  --wa-shadow-medium: rgba(11, 20, 26, .15);\n  --wa-border-bubble: rgba(17, 27, 33, .06);\n\n  /* === Button States === */\n  --wa-button-primary-hover: #017561;\n  --wa-filter-text: #54656f;\n  --wa-filter-active: #008069;\n  --wa-filter-bg-active: #d9fdd3;\n\n  /* === Spacing === */\n  --wa-text-size-small: 12.6px;\n  --wa-bubble-padding-start: 9px;\n  --wa-bubble-padding-end: 7px;\n}\n\n/* === Dark Mode === */\n[data-theme=\"dark\"],\n.dark {\n  /* Surfaces */\n  --wa-bg: #111b21;\n  --wa-bg-deeper: #0b141a;\n  --wa-bg-wash: #161717;\n  --wa-panel-bg: #111b21;\n  --wa-panel-header-bg: #202c33;\n  --wa-conversation-bg: #0b141a;\n  --wa-compose-bg: #202c33;\n\n  /* Content */\n  --wa-text-primary: #e9edef;\n  --wa-text-secondary: #8696a0;\n  --wa-text-deemphasized: rgba(233, 237, 239, 0.4);\n\n  /* Chat Bubbles */\n  --wa-bubble-outgoing: #005c4b;\n  --wa-bubble-incoming: #202c33;\n  --wa-bubble-system: #182229;\n  --wa-bubble-meta: rgba(255, 255, 255, 0.6);\n\n  /* Lines */\n  --wa-border: rgba(233, 237, 239, 0.12);\n  --wa-divider: rgba(134, 150, 160, 0.15);\n\n  /* Interactive */\n  --wa-primary: #00a884;\n  --wa-primary-hover: #06cf9c;\n  --wa-icon-default: #aebac1;\n  --wa-icon-lighter: #8696a0;\n  --wa-hover: rgba(233, 237, 239, 0.05);\n  --wa-active: rgba(233, 237, 239, 0.1);\n\n  /* Read Receipts */\n  --wa-read: #53bdeb;\n  --wa-delivered: #aebac1;\n\n  /* Misc */\n  --wa-unread-marker: #00a884;\n  --wa-typing-dot: #8696a0;\n  --wa-input-bg: #2a3942;\n  --wa-input-border: rgba(233, 237, 239, 0.12);\n\n  /* Chat Wallpaper */\n  --wa-wallpaper-bg: #0b141a;\n  --wa-wallpaper-fg: rgba(255, 255, 255, 0.06);\n  --wa-wallpaper-image: url(\"/wa-wallpaper.png\");\n  --wa-wallpaper-tint: rgba(11, 20, 26, 0.88);\n\n  /* Template header placeholder */\n  --wa-placeholder-bg: #2a3942;\n  --wa-placeholder-icon: brightness(0) saturate(100%) invert(62%) sepia(10%) saturate(400%) hue-rotate(155deg) brightness(95%) contrast(85%);\n\n  /* Template button icon — converts PNG to wa-emerald-400 (#06cf9c) */\n  --wa-btn-icon-filter: brightness(0) saturate(100%) invert(68%) sepia(60%) saturate(400%) hue-rotate(118deg) brightness(100%);\n\n  /* === Semantic Text (dark) === */\n  --wa-text-disabled: #3b4a54;\n  --wa-text-critical: #ff6b7a;\n  --wa-text-success: #25d366;\n  --wa-text-action: #00a884;\n  --wa-system-msg: #8696a0;\n  --wa-primary-title: #8696a0;\n\n  /* === Shadows (dark) === */\n  --wa-shadow-light: rgba(0, 0, 0, .3);\n  --wa-shadow-medium: rgba(0, 0, 0, .4);\n  --wa-border-bubble: rgba(255, 255, 255, .06);\n\n  /* === Button States (dark) === */\n  --wa-button-primary-hover: #06cf9c;\n  --wa-filter-text: #8696a0;\n  --wa-filter-active: #00a884;\n  --wa-filter-bg-active: #005c4b;\n}\n\n/* === Wallpaper === */\n.wa-wallpaper {\n  position: relative;\n  background-color: var(--wa-wallpaper-bg);\n  background-image: var(--wa-wallpaper-image);\n  background-repeat: repeat;\n  background-size: 412px auto;\n  background-blend-mode: overlay;\n}\n\n.dark .wa-wallpaper,\n[data-theme=\"dark\"] .wa-wallpaper {\n  background-blend-mode: soft-light;\n}\n\n/* === Layout Constants === */\n:root {\n  --wa-sidebar-width: 440px;\n  --wa-sidebar-min-width: 340px;\n  --wa-header-height: 59px;\n  --wa-compose-height: 62px;\n  --wa-chat-spacing: 15px;\n  --wa-avatar-size-sm: 40px;\n  --wa-avatar-size-md: 49px;\n  --wa-avatar-size-lg: 200px;\n  --wa-msg-max-width: 60%;\n}\n",
      "type": "registry:file",
      "target": "components/ui/whatsapp/styles/whatsapp.css"
    }
  ],
  "type": "registry:component"
}